{
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "BASE_IMAGE": "${localEnv:BASE_IMAGE}"
        }
    },
    "runArgs": [
        "--privileged",
        "--env-file", ".env"
    ],
    "containerUser": "user",
    "mounts": [
        {
            "type": "bind",
            "source": "${localWorkspaceFolder}/cloud",
            "target": "${containerWorkspaceFolder}/cloud"
        }
    ]
}
